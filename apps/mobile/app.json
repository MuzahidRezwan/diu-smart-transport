{
  "expo": {
    "name": "DIU Transport",
    "slug": "diu-smart-transport",
    "scheme": "diutransport",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "bd.edu.diu.transport",
      "supportsTablet": false,
      "infoPlist": { "NSCameraUsageDescription": "Supervisors scan riders' boarding QR codes." }
    },
    "android": {
      "package": "bd.edu.diu.transport",
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Supervisors scan riders' boarding QR codes." }],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true }
  }
}
