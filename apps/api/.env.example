# Copy to .env and fill in. .env is git-ignored; never commit real values.
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MOBILE_REDIRECT_URI=diutransport://auth

# Leave DATABASE_URL empty to use the embedded PGlite database in ./.data/pglite
DATABASE_URL=
# Production: separate logins for the authority and migration roles (see drizzle/roles.sql)
ADMIN_DATABASE_URL=
MIGRATION_DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-long-random-value
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# University sign-in: mock (development) or oidc (production)
SSO_MODE=mock
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_UNIVERSITY_ID_CLAIM=university_id

# University directory (profile data): mock or http
DIRECTORY_MODE=mock
DIRECTORY_BASE_URL=
DIRECTORY_TOKEN=

# Payments: mock (development) or sslcommerz
PAYMENT_GATEWAY=mock
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=

# console (logs only) or expo
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# Optional: creates the first main admin on an empty database. Remove after first start.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
