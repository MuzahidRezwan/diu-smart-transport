{
  "name": "@diu/api",
  "version": "0.1.0",
  "private": true,
  "description": "DIU Smart Transport API: auth, RBAC, allocation, cards, payments, notices, tracking",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:jobs": "tsx watch --env-file-if-exists=.env src/jobs/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:jobs": "node dist/jobs/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:demo": "tsx --env-file-if-exists=.env src/db/demo.ts",
    "ml:export": "tsx --env-file-if-exists=.env src/db/export-training.ts"
  },
  "dependencies": {
    "@diu/shared": "0.1.0",
    "@electric-sql/pglite": "^0.5.17",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
