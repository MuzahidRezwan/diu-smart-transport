# docker compose: database passwords and shared settings. Copy to .env (git-ignored).
# Application settings are in .env.api (copy from .env.api.example).
# Only the postgres container sees POSTGRES_PASSWORD; the app containers get
# their own least-privilege role passwords (see apps/api/drizzle/roles.sql).
#
# Generate each password/token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

POSTGRES_PASSWORD=change-me-superuser-password
MIGRATOR_DB_PASSWORD=change-me-migrator-password
APP_DB_PASSWORD=change-me-app-password
ADMIN_DB_PASSWORD=change-me-authority-password

ML_SERVICE_TOKEN=change-me-long-random-token

PUBLIC_API_URL=https://api.transport.example.edu.bd

# Used by the "edge" profile to get HTTPS certificates
WEB_DOMAIN=transport.example.edu.bd
API_DOMAIN=api.transport.example.edu.bd
