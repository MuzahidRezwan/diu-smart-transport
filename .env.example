# docker compose settings. Copy to .env (git-ignored) and replace every change-me value.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (passwords, tokens)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (DATA_ENCRYPTION_KEY)

POSTGRES_PASSWORD=change-me-strong-database-password
ML_SERVICE_TOKEN=change-me-long-random-token

PUBLIC_API_URL=https://api.transport.example.edu.bd
WEB_APP_URL=https://transport.example.edu.bd
CORS_ORIGINS=https://transport.example.edu.bd
MOBILE_REDIRECT_URI=diutransport://auth

JWT_SECRET=change-me-generate-a-long-random-value
DATA_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

SSO_MODE=oidc
OIDC_ISSUER=https://sso.example.edu.bd
OIDC_CLIENT_ID=diu-transport
OIDC_CLIENT_SECRET=change-me-from-the-it-division
OIDC_UNIVERSITY_ID_CLAIM=university_id

DIRECTORY_MODE=http
DIRECTORY_BASE_URL=https://directory.example.edu.bd/api
DIRECTORY_TOKEN=change-me-from-the-it-division

PAYMENT_GATEWAY=sslcommerz
SSLCOMMERZ_STORE_ID=change-me
SSLCOMMERZ_STORE_PASSWORD=change-me
SSLCOMMERZ_SANDBOX=true

PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# First start only: creates the main admin, then remove these three lines.
BOOTSTRAP_ADMIN_ID=710215
BOOTSTRAP_ADMIN_NAME=Transport Head
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-characters
